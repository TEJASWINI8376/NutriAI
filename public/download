<!-- Inline Micro-Interaction Script -->
<script>
    (function() {
      const openCamBtn = document.getElementById('btn-open-camera');
      const uploadGalBtn = document.getElementById('btn-upload-gallery');
      const fileInput = document.getElementById('scanner-file-input');

      if (openCamBtn) {
        openCamBtn.addEventListener('click', function() {
          const originalText = openCamBtn.innerHTML;
          openCamBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span><span>Initializing Lens...</span>';
          openCamBtn.classList.add('opacity-90');
          setTimeout(() => {
            openCamBtn.innerHTML = originalText;
            openCamBtn.classList.remove('opacity-90');
            // Navigate or simulate viewfinder trigger
            const camLink = document.querySelector('a[data-path="camera-scanner"]');
            if (camLink) camLink.click();
          }, 600);
        });
      }

      if (uploadGalBtn && fileInput) {
        uploadGalBtn.addEventListener('click', function() {
          fileInput.click();
        });

        fileInput.addEventListener('change', function(e) {
          if (e.target.files && e.target.files[0]) {
            uploadGalBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-primary animate-pulse">sync</span><span>Analyzing...</span>';
            setTimeout(() => {
              uploadGalBtn.innerHTML = '<span>Browse Photos</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span>';
            }, 1200);
          }
        });
      }
