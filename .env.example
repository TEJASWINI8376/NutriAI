# GEMINI_API_KEY: Required for Gemini Vision OCR and AI API calls.
# On Render/Vercel, add this as a server-side environment variable.
# NEVER commit the real API key to Git.
GEMINI_API_KEY=""

# Optional aliases supported by deployment configuration/documentation.
# Prefer GEMINI_API_KEY for NutriAI.
GOOGLE_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

AUTH_SECRET="replace-with-a-long-random-secret"

# Supabase persistence (required when using Supabase-backed deployment)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional persistent data directory for non-serverless hosts
NUTRIAI_DATA_DIR=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
